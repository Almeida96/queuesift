{
  "schemaVersion": 1,
  "consumerIdempotent": true,
  "resolvedFailureCodes": [],
  "maxAttempts": 6,
  "maxAgeSeconds": 86400,
  "maxSnapshotAgeSeconds": 3600,
  "batchSize": 2,
  "ordering": "UNORDERED",
  "payloadRules": [
    {
      "path": "/orderId",
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 128
    },
    {
      "path": "/quantity",
      "type": "integer",
      "required": true,
      "minimum": 1,
      "maximum": 100
    },
    {
      "path": "/channel",
      "type": "string",
      "required": true,
      "allowed": [
        "web",
        "store"
      ]
    }
  ]
}
